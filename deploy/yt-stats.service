# YarnPower statistics panel service.
# Installation: deploy/install.sh (copies the file to /etc/systemd/system/).
[Unit]
Description=YarnPower - panel statystyk YouTube
Documentation=file:///opt/yt-stats/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yt-stats
Group=yt-stats
ExecStart=/opt/yt-stats/yt-stats -config /etc/yt-stats/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# The state directory /var/lib/yt-stats (session file) is created and owned by systemd.
StateDirectory=yt-stats
StateDirectoryMode=0700
UMask=0077

# Memory: a hard limit and a soft limit for the Go garbage collector.
MemoryMax=128M
Environment=GOMEMLIMIT=96MiB

# Hardening. If the service fails to start in a container with status
# 226/NAMESPACE, see the "Troubleshooting" section in deploy/README.md.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/yt-stats /etc/yt-stats
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
